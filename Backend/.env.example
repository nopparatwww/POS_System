# Backend environment variables example
# Copy this to .env and fill in values before running in production

# Server
PORT=3000
NODE_ENV=production

# MongoDB (Atlas or connection string)
MONGODB_URI=
MONGO_URI=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=1h

# CORS and IP whitelist
CORS_ORIGINS=
ALLOWED_IPS=

# Stripe (if using payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Security
BCRYPT_ROUNDS=12
PASSWORD_PEPPER=

# Logging and rate limiting
LOG_IP_WHITELIST=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=100
# Backend environment variables
PORT=3000
# For production, set this to your actual Mongo connection string.
# Local dev example:
MONGO_URI=mongodb://127.0.0.1:27017/pos_system
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_HEX
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
# Optional additional secret added to passwords before hashing. Keep empty or set in secret manager.
PASSWORD_PEPPER=
# Optional default admin passwords for seeding scripts
ADMIN_DEFAULT_PASS=
ADMIN2_DEFAULT_PASS=

# Stripe (required if using payments)
# Obtain from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
